# 2B Tex environment example
# انسخ القيم المطلوبة إلى Environment Variables أو ملف .env محلي غير مرفوع.

# مطلوب: بدون SYSTEM_PASS لن يعمل الدخول الافتراضي (لا توجد كلمة مرور مضمّنة في الكود).
SYSTEM_USER=admin
SYSTEM_PASS=change-this-strong-password

# مطلوب أمنيًا: سر مستقل لتوقيع الجلسات (لا تتركه فارغًا حتى لا يعتمد على SYSTEM_PASS).
AUTH_SECRET=change-this-random-session-secret

PORT=3000
BACKEND_PORT=3050
DB_PATH=backend/data/2btex.sqlite

# Database engine
# Default is SQLite for local/single-machine operation.
DB_CLIENT=sqlite

# SQL Server mode for multi-device work.
# Use SQL Server Express/Standard as a Windows service, not LocalDB, when several devices will use the system.
# DB_CLIENT=mssql
# MSSQL_SERVER=SERVER-NAME\SQLEXPRESS
# MSSQL_DATABASE=2BTex
# MSSQL_USER=2btex_app
# MSSQL_PASSWORD=change-this-strong-password
# MSSQL_ENCRYPT=0
# MSSQL_TRUST_CERT=1
# Optional one-time migration helper:
# MSSQL_CREATE_DATABASE=1
# SQLITE_SOURCE_PATH=F:\2B Tex\system\server-data\2btex.sqlite

# اختياري: عناوين الربط الداخلية. الافتراضي 127.0.0.1 (لا تعرّض الخلفية/واتساب على الشبكة).
# BACKEND_HOST=127.0.0.1
# WHATSAPP_HOST=127.0.0.1

# اختياري: حماية الدخول من التخمين.
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_LOCK_MS=900000

# Optional services
OPENAI_API_KEY=
