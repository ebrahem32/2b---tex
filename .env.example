# 2B Tex environment example
# انسخ القيم المطلوبة إلى Environment Variables أو ملف .env محلي غير مرفوع.

# مطلوب: بدون SYSTEM_PASS لن يعمل الدخول الافتراضي (لا توجد كلمة مرور مضمّنة في الكود).
SYSTEM_USER=admin
SYSTEM_PASS=change-this-strong-password

# مطلوب أمنيًا: سر مستقل لتوقيع الجلسات (لا تتركه فارغًا حتى لا يعتمد على SYSTEM_PASS).
AUTH_SECRET=change-this-random-session-secret

PORT=3000
BACKEND_PORT=3050
DB_PATH=backend/data/2btex.sqlite

# اختياري: عناوين الربط الداخلية. الافتراضي 127.0.0.1 (لا تعرّض الخلفية/واتساب على الشبكة).
# BACKEND_HOST=127.0.0.1
# WHATSAPP_HOST=127.0.0.1

# اختياري: حماية الدخول من التخمين.
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_LOCK_MS=900000

# Optional services
OPENAI_API_KEY=
